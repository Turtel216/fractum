// ==========================================
// Model.fr
// The application layer: state, messages, and the update loop
// ==========================================
//
// This is the middle of the Elm Architecture. The model is a value, messages
// are an enum, and update is a pure function from one to the other. Nothing in
// this file touches the DOM or performs an effect: side effects are returned
// as Cmd values and carried out by the runtime, which feeds their results back
// in as ordinary messages.

import {
    List,
    list_cons,
    list_nil,
    list_length
} from "../../stdlib/Functional";
import { Option } from "../../stdlib/Option";
import { Result } from "../../stdlib/Result";
import { Cmd, cmd_none, cmd_batch } from "../../stdlib/Cmd";
import {
    Task,
    Priority,
    Filter,
    make_task,
    priority_from_name,
    add_task,
    toggle_task,
    delete_task,
    cycle_task_priority,
    move_task_up,
    move_task_down,
    drop_done,
    validate_title
} from "./Task";

// ---------------------------------------------------------
// Constants
// ---------------------------------------------------------

// Shared with View.fr, which puts this id on the text field, and used here by
// the FocusElement command. Keeping it in one place is what stops the two from
// drifting apart.
export let draft_input_id = "draft-input";

// Where the theme choice is persisted between visits.
let theme_storage_key = "fractum.taskboard.theme";

// Relative URL fetched by the tips panel. Serving the example over HTTP makes
// this succeed; opening the file directly makes it fail, and both paths are
// handled below.
let tips_url = "tips.txt";

// How long a notice stays on screen before it dismisses itself.
let notice_delay_ms = 2600;

// Key codes for the global keyboard shortcuts.
let key_escape = 27;
let key_one = 49;
let key_two = 50;
let key_three = 51;
let key_n = 78;
let key_r = 82;
let key_t = 84;

// ---------------------------------------------------------
// State
// ---------------------------------------------------------

export enum Theme {
    Dark,
    Light,
}

// A transient message shown under the composer. Encoding the severity in the
// enum rather than in a Bool keeps the view honest: it has to handle both.
export enum Notice {
    Info(String),
    Problem(String),
}

// The lifecycle of the tips request. Modelling all four states explicitly is
// what makes an impossible combination (loading and failed at once, say)
// unrepresentable.
export enum Sync {
    Idle,
    Loading,
    Loaded(String),
    Failed(String),
}

// The model is split into four records rather than one flat one. Records have
// no update syntax, so every change rebuilds the record it belongs to: keeping
// them small keeps the rebuild to a single short line.
export type Board = { tasks: List<Task>, filter: Filter, next_id: Int, spotlight: Option<Int> };
export type Draft = { text: String, priority: Priority, focused: Bool };
export type Timer = { seconds: Int, running: Bool };
export type Ui = { theme: Theme, notice: Option<Notice>, hovered: Option<Int>, width: Option<Int>, tips: Sync };

export type Model = { board: Board, draft: Draft, timer: Timer, ui: Ui };

// ---------------------------------------------------------
// Messages
// ---------------------------------------------------------
//
// Every single thing that can happen to this application. The view can only
// produce values of this type, and update is the only place that consumes
// them, so this enum is an exhaustive inventory of the application's behaviour.

export enum Msg {
    // Composer
    DraftChanged(String),
    DraftPriorityChanged(String),
    DraftKeyPressed(Int),
    DraftFocused,
    DraftBlurred,
    DraftSubmitted,
    // Rows
    TaskToggled(Int),
    TaskDeleted(Int),
    TaskPriorityCycled(Int),
    TaskMovedUp(Int),
    TaskMovedDown(Int),
    TaskHovered(Int),
    TaskUnhovered,
    // Board level
    FilterSelected(Filter),
    DoneCleared,
    SpotlightRequested,
    SpotlightPicked(Int),
    SpotlightCleared,
    NoticeDismissed,
    // Timer
    TimerToggled,
    TimerReset,
    Ticked(Int),
    // Environment
    KeyPressed(Int),
    WindowResized(Int, Int),
    ThemeToggled,
    ThemeRestored(Option<String>),
    TipsRequested,
    TipsReceived(Result<String, String>),
    // Deliberately does nothing. Keystrokes that are not shortcuts land here.
    Ignored,
}

// What init and update both return: the next model plus whatever the runtime
// should go and do about it.
export type Step = { model: Model, cmd: Cmd<Msg> };

// ---------------------------------------------------------
// Record updates
// ---------------------------------------------------------
//
// These stand in for the update syntax the language does not have yet. Each
// one rebuilds a single record with one field replaced, which keeps update
// itself free of long record literals.

function with_board(model: Model, board: Board): Model {
    return { board: board, draft: model.draft, timer: model.timer, ui: model.ui };
}

function with_draft(model: Model, draft: Draft): Model {
    return { board: model.board, draft: draft, timer: model.timer, ui: model.ui };
}

function with_timer(model: Model, timer: Timer): Model {
    return { board: model.board, draft: model.draft, timer: timer, ui: model.ui };
}

function with_ui(model: Model, ui: Ui): Model {
    return { board: model.board, draft: model.draft, timer: model.timer, ui: ui };
}

function board_with_tasks(board: Board, tasks: List<Task>): Board {
    return { tasks: tasks, filter: board.filter, next_id: board.next_id, spotlight: board.spotlight };
}

function board_with_filter(board: Board, filter: Filter): Board {
    return { tasks: board.tasks, filter: filter, next_id: board.next_id, spotlight: board.spotlight };
}

function board_with_spotlight(board: Board, spotlight: Option<Int>): Board {
    return { tasks: board.tasks, filter: board.filter, next_id: board.next_id, spotlight: spotlight };
}

function ui_with_theme(ui: Ui, theme: Theme): Ui {
    return { theme: theme, notice: ui.notice, hovered: ui.hovered, width: ui.width, tips: ui.tips };
}

function ui_with_notice(ui: Ui, notice: Option<Notice>): Ui {
    return { theme: ui.theme, notice: notice, hovered: ui.hovered, width: ui.width, tips: ui.tips };
}

function ui_with_hovered(ui: Ui, hovered: Option<Int>): Ui {
    return { theme: ui.theme, notice: ui.notice, hovered: hovered, width: ui.width, tips: ui.tips };
}

function ui_with_width(ui: Ui, width: Option<Int>): Ui {
    return { theme: ui.theme, notice: ui.notice, hovered: ui.hovered, width: width, tips: ui.tips };
}

function ui_with_tips(ui: Ui, tips: Sync): Ui {
    return { theme: ui.theme, notice: ui.notice, hovered: ui.hovered, width: ui.width, tips: tips };
}

// ---------------------------------------------------------
// Step builders
// ---------------------------------------------------------

// A new model with nothing for the runtime to do.
function stay(model: Model): Step {
    return { model: model, cmd: cmd_none() };
}

// A new list of tasks, everything else untouched.
function with_tasks(model: Model, tasks: List<Task>): Step {
    return stay(with_board(model, board_with_tasks(model.board, tasks)));
}

// Shows a notice and asks the runtime to send NoticeDismissed back after a
// delay. This is the smallest complete example of the effect cycle: update
// describes an effect, the runtime performs it, and the result arrives as an
// ordinary message.
function notify(model: Model, notice: Notice): Step {
    return {
        model: with_ui(model, ui_with_notice(model.ui, Option::Some(notice))),
        cmd: Cmd::Delay(notice_delay_ms, Msg::NoticeDismissed),
    };
}

// ---------------------------------------------------------
// Theme
// ---------------------------------------------------------

export function theme_name(theme: Theme): String {
    return match (theme) {
        Theme::Dark => "dark",
        Theme::Light => "light",
    };
}

function theme_from_name(name: String): Theme {
    return if (name == "light") Theme::Light else Theme::Dark;
}

// The stored value arrives as an Option because local storage may not have the
// key at all. There is no null to guard against, only a case to handle.
function restore_theme(model: Model, stored: Option<String>): Step {
    return match (stored) {
        Option::None => stay(model),
        Option::Some(name) => stay(with_ui(model, ui_with_theme(model.ui, theme_from_name(name)))),
    };
}

function toggle_theme(model: Model): Step {
    let next = match (model.ui.theme) {
        Theme::Dark => Theme::Light,
        Theme::Light => Theme::Dark,
    };
    return {
        model: with_ui(model, ui_with_theme(model.ui, next)),
        cmd: Cmd::StorageSet(theme_storage_key, theme_name(next)),
    };
}

// ---------------------------------------------------------
// The composer
// ---------------------------------------------------------

function set_draft_text(model: Model, txt: String): Model {
    return with_draft(model, { text: txt, priority: model.draft.priority, focused: model.draft.focused });
}

function set_draft_priority(model: Model, priority: Priority): Model {
    return with_draft(model, { text: model.draft.text, priority: priority, focused: model.draft.focused });
}

function set_draft_focus(model: Model, focused: Bool): Model {
    return with_draft(model, { text: model.draft.text, priority: model.draft.priority, focused: focused });
}

// Appends the validated title to the board, clears the composer, and batches
// three effects into the single Cmd that update is allowed to return.
function commit_draft(model: Model, title: String): Step {
    let board = model.board;
    let task = make_task(board.next_id, title, model.draft.priority);
    let filled = {
        tasks: add_task(board.tasks, task),
        filter: board.filter,
        next_id: board.next_id + 1,
        spotlight: board.spotlight,
    };
    let cleared = set_draft_text(with_board(model, filled), "");
    return {
        model: with_ui(cleared, ui_with_notice(cleared.ui, Option::Some(Notice::Info("Added " + title)))),
        cmd: cmd_batch([
            Cmd::ConsoleLog("task added: " + title),
            Cmd::FocusElement(draft_input_id),
            Cmd::Delay(notice_delay_ms, Msg::NoticeDismissed),
        ]),
    };
}

// Validation is a Result, so both outcomes have to be spelled out here.
function submit_draft(model: Model): Step {
    return match (validate_title(model.board.tasks, model.draft.text)) {
        Result::Ok(title) => commit_draft(model, title),
        Result::Err(problem) => notify(model, Notice::Problem(problem)),
    };
}

// ---------------------------------------------------------
// Spotlight
// ---------------------------------------------------------

// Asks the runtime for a random index into the board. The chosen index comes
// back as SpotlightPicked, which is where it is turned into a task id.
function request_spotlight(model: Model): Step {
    let total = list_length(model.board.tasks);
    return if (total == 0)
        notify(model, Notice::Problem("There is nothing to pick from yet."))
    else
        { model: model, cmd: Cmd::RandomInt(0, total - 1, (i) => Msg::SpotlightPicked(i)) };
}

function set_spotlight(model: Model, spotlight: Option<Int>): Step {
    return stay(with_board(model, board_with_spotlight(model.board, spotlight)));
}

// ---------------------------------------------------------
// Timer
// ---------------------------------------------------------
//
// The timer is driven by a subscription rather than by a command: Main.fr asks
// for a tick every second only while running is true, so pausing the clock
// removes the interval instead of leaving it spinning.

function toggle_timer(model: Model): Step {
    return stay(with_timer(model, { seconds: model.timer.seconds, running: !model.timer.running }));
}

function reset_timer(model: Model): Step {
    return stay(with_timer(model, { seconds: 0, running: model.timer.running }));
}

// ---------------------------------------------------------
// Keyboard shortcuts
// ---------------------------------------------------------

// Global keystrokes are ignored while the text field has focus, which is what
// the focused flag on the draft is for: without it, typing the letter n into
// the composer would also trigger the shortcut bound to n.
function handle_key(model: Model, code: Int): Step {
    return if (model.draft.focused)
        stay(model)
    else if (code == key_n)
        { model: model, cmd: Cmd::FocusElement(draft_input_id) }
    else if (code == key_r)
        request_spotlight(model)
    else if (code == key_t)
        toggle_timer(model)
    else if (code == key_one)
        stay(with_board(model, board_with_filter(model.board, Filter::All)))
    else if (code == key_two)
        stay(with_board(model, board_with_filter(model.board, Filter::Active)))
    else if (code == key_three)
        stay(with_board(model, board_with_filter(model.board, Filter::Done)))
    else if (code == key_escape)
        set_spotlight(with_ui(model, ui_with_notice(model.ui, Option::None)), Option::None)
    else
        stay(model);
}

// Escape inside the composer clears whatever has been typed so far.
function handle_draft_key(model: Model, code: Int): Step {
    return if (code == key_escape) stay(set_draft_text(model, "")) else stay(model);
}

// ---------------------------------------------------------
// Tips over HTTP
// ---------------------------------------------------------

// The response is a Result, so the failure branch is as visible in the source
// as the success branch, and neither one can be forgotten.
function receive_tips(model: Model, response: Result<String, String>): Step {
    let next = match (response) {
        Result::Ok(body) => Sync::Loaded(body),
        Result::Err(problem) => Sync::Failed(problem),
    };
    return stay(with_ui(model, ui_with_tips(model.ui, next)));
}

// ---------------------------------------------------------
// Init
// ---------------------------------------------------------

export function init(): Step {
    let seeded = list_cons(
        make_task(1, "Read the Fractum language guide", Priority::Medium),
        list_cons(
            make_task(2, "Model the board as an enum and a record", Priority::High),
            list_cons(make_task(3, "Compile the example to JavaScript", Priority::Low), list_nil())
        )
    );
    return {
        model: {
            board: { tasks: toggle_task(seeded, 3), filter: Filter::All, next_id: 4, spotlight: Option::None },
            draft: { text: "", priority: Priority::Low, focused: false },
            timer: { seconds: 0, running: false },
            ui: {
                theme: Theme::Dark,
                notice: Option::None,
                hovered: Option::None,
                width: Option::None,
                tips: Sync::Idle,
            },
        },
        // Two effects at boot: read back the theme chosen on a previous visit,
        // and leave a note in the console that the loop is running.
        cmd: cmd_batch([
            Cmd::StorageGet(theme_storage_key, (stored) => Msg::ThemeRestored(stored)),
            Cmd::ConsoleLog("fractum task board ready"),
        ]),
    };
}

// ---------------------------------------------------------
// Update
// ---------------------------------------------------------
//
// One arm per message. The compiler checks that the match is exhaustive, so
// adding a variant to Msg above turns every unhandled case into a compile
// error rather than a silent no-op at runtime.

export function update(msg: Msg, model: Model): Step {
    return match (msg) {
        Msg::DraftChanged(txt) => stay(set_draft_text(model, txt)),
        Msg::DraftPriorityChanged(name) => stay(set_draft_priority(model, priority_from_name(name))),
        Msg::DraftKeyPressed(code) => handle_draft_key(model, code),
        Msg::DraftFocused => stay(set_draft_focus(model, true)),
        Msg::DraftBlurred => stay(set_draft_focus(model, false)),
        Msg::DraftSubmitted => submit_draft(model),

        Msg::TaskToggled(id) => with_tasks(model, toggle_task(model.board.tasks, id)),
        Msg::TaskDeleted(id) => with_tasks(model, delete_task(model.board.tasks, id)),
        Msg::TaskPriorityCycled(id) => with_tasks(model, cycle_task_priority(model.board.tasks, id)),
        Msg::TaskMovedUp(id) => with_tasks(model, move_task_up(model.board.tasks, id)),
        Msg::TaskMovedDown(id) => with_tasks(model, move_task_down(model.board.tasks, id)),
        Msg::TaskHovered(id) => stay(with_ui(model, ui_with_hovered(model.ui, Option::Some(id)))),
        Msg::TaskUnhovered => stay(with_ui(model, ui_with_hovered(model.ui, Option::None))),

        Msg::FilterSelected(filter) => stay(with_board(model, board_with_filter(model.board, filter))),
        Msg::DoneCleared => with_tasks(model, drop_done(model.board.tasks)),
        Msg::SpotlightRequested => request_spotlight(model),
        Msg::SpotlightPicked(index) => set_spotlight(model, Option::Some(index)),
        Msg::SpotlightCleared => set_spotlight(model, Option::None),
        Msg::NoticeDismissed => stay(with_ui(model, ui_with_notice(model.ui, Option::None))),

        Msg::TimerToggled => toggle_timer(model),
        Msg::TimerReset => reset_timer(model),
        Msg::Ticked(stamp) => stay(with_timer(model, { seconds: model.timer.seconds + 1, running: model.timer.running })),

        Msg::KeyPressed(code) => handle_key(model, code),
        Msg::WindowResized(width, height) => stay(with_ui(model, ui_with_width(model.ui, Option::Some(width)))),
        Msg::ThemeToggled => toggle_theme(model),
        Msg::ThemeRestored(stored) => restore_theme(model, stored),
        Msg::TipsRequested => {
            model: with_ui(model, ui_with_tips(model.ui, Sync::Loading)),
            cmd: Cmd::HttpGet(tips_url, (response) => Msg::TipsReceived(response)),
        },
        Msg::TipsReceived(response) => receive_tips(model, response),

        Msg::Ignored => stay(model),
    };
}
