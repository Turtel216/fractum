// ==========================================
// Counter.tjs
// Example: A complete counter app using the Elm Architecture
// ==========================================
//
// This demonstrates all three components working together:
//   1. Html<Msg> for building the UI, imported from the standard library
//   2. Cmd<Msg> for side effects, imported from the standard library
//   3. app(), which boots the Model-View-Update loop (see
//      runtime/fractum_runtime.js, global.TypedJS.app)

import { Attribute, Html, div, span, h1, label, button, input, text } from "../stdlib/Html";
import { Cmd, cmd_none } from "../stdlib/Cmd";

// -- Model --

type Model = { count: Int, label: String };

// -- Messages --

enum Msg {
    Increment,
    Decrement,
    Reset,
    SetLabel(String),
    DelayedIncrement,
    IncrementAfterDelay,
}

// -- Init --

function init(): { model: Model, cmd: Cmd<Msg> } {
    return { model: { count: 0, label: "Counter" }, cmd: cmd_none() };
}

// -- Update --
// Pure function: takes a message and current model, returns { model, cmd }.
// No side effects happen here -- Cmd values are descriptions, not actions.

function update(msg: Msg, model: Model): { model: Model, cmd: Cmd<Msg> } {
    return match (msg) {
        Msg::Increment => { model: { count: model.count + 1, label: model.label }, cmd: cmd_none() },
        Msg::Decrement => { model: { count: model.count - 1, label: model.label }, cmd: cmd_none() },
        Msg::Reset => { model: { count: 0, label: model.label }, cmd: cmd_none() },
        Msg::SetLabel(newLabel) => { model: { count: model.count, label: newLabel }, cmd: cmd_none() },
        Msg::DelayedIncrement => { model: model, cmd: Cmd::Delay(1000, Msg::IncrementAfterDelay) },
        Msg::IncrementAfterDelay => { model: { count: model.count + 1, label: model.label }, cmd: Cmd::ConsoleLog("Delayed increment complete!") },
    };
}

// -- View --
// Pure function: model -> virtual DOM tree, built with the Html.tjs helpers.
// No mutation, no side effects.

function view(model: Model): Html<Msg> {
    return div([Attribute::Class("app-container")], [
        h1([], [text(model.label)]),

        div([Attribute::Class("counter-display")], [
            span([Attribute::Class("count")], [text(toString(model.count))]),
        ]),

        div([Attribute::Class("button-group")], [
            button(
                [Attribute::OnClick(Msg::Decrement), Attribute::Class("btn btn-minus")],
                [text("-")]
            ),
            button(
                [Attribute::OnClick(Msg::Reset), Attribute::Class("btn btn-reset")],
                [text("Reset")]
            ),
            button(
                [Attribute::OnClick(Msg::Increment), Attribute::Class("btn btn-plus")],
                [text("+")]
            ),
        ]),

        div([Attribute::Class("delay-section")], [
            button(
                [Attribute::OnClick(Msg::DelayedIncrement), Attribute::Class("btn btn-delay")],
                [text("Increment after 1s")]
            ),
        ]),

        div([Attribute::Class("label-section")], [
            label([], [text("Label: ")]),
            input([
                Attribute::Type("text"),
                Attribute::Value(model.label),
                Attribute::OnInput((s) => Msg::SetLabel(s)),
                Attribute::Placeholder("Enter a label..."),
            ]),
        ]),
    ]);
}

// -- Boot --
// Wires init/update/view into the runtime and mounts onto <div id="app">.

app({
    init:   init,
    update: update,
    view:   view,
    root:   "app",
});
