// ==========================================
// Dom.tjs
// Strict DOM Query Boundary
// ==========================================
//
// These types define the strict boundary for querying the actual DOM.
// All query functions return Option values to guarantee safety (no null or undefined).
//
// NOTE: The functions below are implemented in the JS runtime (TypedJS.dom,
// see runtime/fractum_runtime.js) rather than compiled from Fractum source.
// The compiler has no foreign-function interface yet, so they cannot be
// imported and called from application code today; these declarations
// document the boundary contract for when that lands.

// Opaque type -- user cannot construct or pattern match on this
export type DomElement = { _opaque: Bool };

export enum DomError {
    NotFound(String),
    InvalidSelector(String),
}

// Runtime-provided functions (not yet callable from Fractum source):
//   get_element_by_id(id: String) -> Option<DomElement>
//   query_selector(selector: String) -> Option<DomElement>
//   get_attribute(el: DomElement, name: String) -> Option<String>
//   get_text_content(el: DomElement) -> Option<String>
