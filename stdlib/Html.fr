// Void Elements (No children)
export function input<Msg>(attrs: [Attribute<Msg>]): Html<Msg> {
    return Html::Node("input", attrs, []);
}

export function img<Msg>(attrs: [Attribute<Msg>]): Html<Msg> {
    return Html::Node("img", attrs, []);
}

export function br<Msg>(attrs: [Attribute<Msg>]): Html<Msg> {
