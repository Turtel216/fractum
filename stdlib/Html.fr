// ==========================================
// Html.tjs
// Virtual DOM and HTML Builder Functions
// ==========================================

// Attribute<Msg> — all the attributes a DOM node can have.
// Event handlers are strictly typed to enforce sanitization and prevent arbitrary
// DOM events from leaking into the pure application logic.
export enum Attribute<Msg> {
    Class(String),
    Id(String),
    Style(String, String),         // property, value
    Placeholder(String),
    Value(String),
    Type(String),
    Disabled(Bool),
    Href(String),
    Src(String),
    Alt(String),
    // Event handlers — STRICT: carry typed data only
    OnClick(Msg),                  // fires Msg directly, no event data
    OnInput(String -> Msg),        // extracts e.target.value, maps to Msg
    OnSubmit(Msg),                 // fires Msg, prevents default
    OnChange(String -> Msg),       // extracts e.target.value
    OnMouseEnter(Msg),
    OnMouseLeave(Msg),
    OnKeyDown(Int -> Msg),         // extracts keyCode as Int
    OnFocus(Msg),
    OnBlur(Msg),
}

// KeyedItem<Msg> — a keyed child (no tuples in the language).
// This is a type alias rather than an enum because Html<Msg> and KeyedItem<Msg>
// are mutually recursive, and the compiler resolves enum variant field types
// eagerly at declaration time, so one side of a recursive pair must be a
// lazily-expanded alias instead of a second enum.
export type KeyedItem<Msg> = { key: String, child: Html<Msg> };

// Html<Msg> — the Virtual DOM tree
export enum Html<Msg> {
    Node(String, [Attribute<Msg>], [Html<Msg>]),
    Keyed(String, [Attribute<Msg>], [KeyedItem<Msg>]),
    Text(String),
    Empty,
}

// ---------------------------------------------------------
// Builder Functions
// ---------------------------------------------------------

export function text<Msg>(content: String): Html<Msg> {
    return Html::Text(content);
}

// Standard Elements
export function div<Msg>(attrs: [Attribute<Msg>], children: [Html<Msg>]): Html<Msg> {
    return Html::Node("div", attrs, children);
}

export function span<Msg>(attrs: [Attribute<Msg>], children: [Html<Msg>]): Html<Msg> {
    return Html::Node("span", attrs, children);
}

export function p<Msg>(attrs: [Attribute<Msg>], children: [Html<Msg>]): Html<Msg> {
    return Html::Node("p", attrs, children);
}

export function button<Msg>(attrs: [Attribute<Msg>], children: [Html<Msg>]): Html<Msg> {
    return Html::Node("button", attrs, children);
}

export function h1<Msg>(attrs: [Attribute<Msg>], children: [Html<Msg>]): Html<Msg> {
    return Html::Node("h1", attrs, children);
}

export function h2<Msg>(attrs: [Attribute<Msg>], children: [Html<Msg>]): Html<Msg> {
    return Html::Node("h2", attrs, children);
}

export function h3<Msg>(attrs: [Attribute<Msg>], children: [Html<Msg>]): Html<Msg> {
