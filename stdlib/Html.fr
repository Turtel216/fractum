}

export function h4<Msg>(attrs: [Attribute<Msg>], children: [Html<Msg>]): Html<Msg> {
    return Html::Node("h4", attrs, children);
}

export function h5<Msg>(attrs: [Attribute<Msg>], children: [Html<Msg>]): Html<Msg> {
