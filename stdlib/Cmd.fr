// ==========================================
// Cmd.tjs
// Side-Effect Command System
// ==========================================
//
// The Cmd type represents descriptions of side-effects that the runtime should
// execute. Rather than performing effects directly, the application returns Cmd
// values, and the runtime interprets them and eventually feeds results back
// into the application as Messages.

import { Result } from "./Result";
import { Option } from "./Option";

export enum Cmd<Msg> {
    CmdNone,
    CmdBatch([Cmd<Msg>]),
    HttpGet(String, (Result<String, String>) -> Msg),
    HttpPost(String, String, (Result<String, String>) -> Msg),  // url, body, handler
    Delay(Int, Msg),                    // milliseconds, then dispatch Msg
    RandomInt(Int, Int, (Int) -> Msg),  // min, max, mapper
    GetTime((Int) -> Msg),               // timestamp in milliseconds (no Float type yet)
    FocusElement(String),               // by ID, fire-and-forget
    ConsoleLog(String),
    StorageGet(String, (Option<String>) -> Msg),
    StorageSet(String, String),
}

// ---------------------------------------------------------
// Helper Functions
// ---------------------------------------------------------

// Returns a command that does nothing. Useful for branches that have no side-effects.
export function cmd_none<Msg>(): Cmd<Msg> {
    return Cmd::CmdNone;
}

// Combines multiple commands into a single batched command.
// The runtime will execute them all concurrently.
export function cmd_batch<Msg>(cmds: [Cmd<Msg>]): Cmd<Msg> {
    return Cmd::CmdBatch(cmds);
}
