// Void Elements (No children)
function input<Msg>(attrs: [Attribute<Msg>]): Html<Msg> {
    return Html::Node("input", attrs, []);
}

function img<Msg>(attrs: [Attribute<Msg>]): Html<Msg> {
    return Html::Node("img", attrs, []);
