// ==========================================
// Html.tjs
// Virtual DOM and HTML Builder Functions
// ==========================================

// Attribute<Msg> — all the attributes a DOM node can have.
// Event handlers are strictly typed to enforce sanitization and prevent arbitrary
// DOM events from leaking into the pure application logic.
enum Attribute<Msg> {
    Class(String),
    Id(String),
    Style(String, String),         // property, value
    Placeholder(String),
    Value(String),
    Type(String),
    Disabled(Bool),
    Href(String),
    Src(String),
    Alt(String),
    // Event handlers — STRICT: carry typed data only
    OnClick(Msg),                  // fires Msg directly, no event data
    OnInput(String -> Msg),        // extracts e.target.value, maps to Msg
    OnSubmit(Msg),                 // fires Msg, prevents default
    OnChange(String -> Msg),       // extracts e.target.value
    OnMouseEnter(Msg),
    OnMouseLeave(Msg),
    OnKeyDown(Int -> Msg),         // extracts keyCode as Int
    OnFocus(Msg),
    OnBlur(Msg),
}

// KeyedItem<Msg> — used for keyed children (no tuples in the language)
enum KeyedItem<Msg> {
    KeyedItem(String, Html<Msg>),
}

// Html<Msg> — the Virtual DOM tree
enum Html<Msg> {
    Node(String, [Attribute<Msg>], [Html<Msg>]),
    Keyed(String, [Attribute<Msg>], [KeyedItem<Msg>]),
    Text(String),
    Empty,
}

// ---------------------------------------------------------
// Builder Functions
// ---------------------------------------------------------

function text<Msg>(content: String): Html<Msg> {
    return Html::Text(content);
}

// Standard Elements
function div<Msg>(attrs: [Attribute<Msg>], children: [Html<Msg>]): Html<Msg> {
    return Html::Node("div", attrs, children);
}

function span<Msg>(attrs: [Attribute<Msg>], children: [Html<Msg>]): Html<Msg> {
    return Html::Node("span", attrs, children);
}

function p<Msg>(attrs: [Attribute<Msg>], children: [Html<Msg>]): Html<Msg> {
    return Html::Node("p", attrs, children);
}

function button<Msg>(attrs: [Attribute<Msg>], children: [Html<Msg>]): Html<Msg> {
    return Html::Node("button", attrs, children);
}

function h1<Msg>(attrs: [Attribute<Msg>], children: [Html<Msg>]): Html<Msg> {
    return Html::Node("h1", attrs, children);
}

