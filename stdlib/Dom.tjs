// ==========================================
// Dom.tjs
// Strict DOM Query Boundary
// ==========================================
//
// These functions provide a strict boundary for querying the actual DOM.
// They return Option values to guarantee safety (no null or undefined).
// NOTE: These are implemented in the JS runtime. The signatures here serve
// as specifications and type definitions for the application code.

// Opaque type — user cannot construct or pattern match on this
type DomElement = { _opaque: Bool };

enum DomError {
    NotFound(String),
    InvalidSelector(String),
}

// All DOM queries return Option — never null, never undefined.
// The runtime provides the actual implementation.

