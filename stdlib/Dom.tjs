    // Implemented in JS runtime
    // return Option::None;
}

// Retrieves the first element matching a CSS selector.
function query_selector(selector: String): Option<DomElement> {
    // Implemented in JS runtime
    // return Option::None;
}

// Retrieves the value of a specific attribute on an element safely.
function get_attribute(el: DomElement, name: String): Option<String> {
    // Implemented in JS runtime
    // return Option::None;
}

// Retrieves the text content of a given element.
function get_text_content(el: DomElement): Option<String> {
